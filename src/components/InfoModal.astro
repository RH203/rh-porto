---
import { portfolioData } from '../data/portfolioData';
---

<div
  id="info-modal-backdrop"
  class="fixed inset-0 z-50 bg-[#282a36]/80 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6 transition-opacity duration-200 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div
    id="info-modal-card"
    class="relative w-full max-w-2xl max-h-[88vh] overflow-y-auto bg-[#343746] border-2 border-[#bd93f9] rounded-3xl p-5 sm:p-7 text-[#f8f8f2] shadow-2xl transition-transform duration-200 scale-95"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-4 border-b border-[#44475a] mb-5">
      <div class="flex items-center gap-2.5">
        <span id="modal-icon" class="text-2xl">✨</span>
        <div>
          <h2 id="modal-title" class="text-lg sm:text-xl font-bold tracking-tight text-[#50fa7b]">
            Information
          </h2>
          <p id="modal-subtitle" class="text-xs text-[#8be9fd]">Zone detail</p>
        </div>
      </div>
      <button
        id="modal-close-btn"
        type="button"
        class="w-10 h-10 rounded-2xl bg-[#282a36] hover:bg-[#ff5555] text-[#f8f8f2] flex items-center justify-center font-bold text-lg border border-[#44475a] transition-colors focus:outline-none focus:ring-2 focus:ring-[#ff79c6]"
        aria-label="Tutup jendela informasi"
      >
        ✕
      </button>
    </div>

    <!-- Section: Projects -->
    <div id="section-projects" class="modal-section hidden space-y-4">
      {portfolioData.projects.map((proj) => (
        <article class="bg-[#282a36] border border-[#44475a] p-4 sm:p-5 rounded-2xl hover:border-[#bd93f9] transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
            <div>
              <h3 class="font-bold text-base text-[#bd93f9]">{proj.title}</h3>
              <p class="text-xs text-[#8be9fd] font-medium">{proj.subtitle}</p>
            </div>
            <span class="text-[11px] font-mono text-[#6272a4]">{proj.period}</span>
          </div>
          <p class="text-xs text-[#f8f8f2] mb-3 leading-relaxed">{proj.description}</p>
          <div class="mb-3">
            <h4 class="text-[11px] uppercase font-bold text-[#50fa7b] mb-1.5">Key Highlights</h4>
            <ul class="text-xs text-[#f8f8f2]/90 space-y-1 list-disc list-inside">
              {proj.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-1">
            {proj.tags.map((tag) => (
              <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-[#44475a] text-[#50fa7b] font-mono">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Section: Experience -->
    <div id="section-experience" class="modal-section hidden space-y-4">
      {portfolioData.experiences.map((exp) => (
        <article class="bg-[#282a36] border border-[#44475a] p-4 sm:p-5 rounded-2xl hover:border-[#ff79c6] transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
            <div>
              <h3 class="font-bold text-base text-[#ff79c6]">{exp.company}</h3>
              <p class="text-xs text-[#50fa7b] font-semibold">{exp.role} ({exp.location})</p>
            </div>
            <span class="text-[11px] font-mono text-[#6272a4]">{exp.period}</span>
          </div>
          <ul class="text-xs space-y-1.5 list-disc list-inside mb-3 text-[#f8f8f2]/90 leading-relaxed">
            {exp.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-1">
            {exp.techStack.map((tech) => (
              <span class="text-[11px] px-2 py-0.5 rounded-md bg-[#44475a] text-[#8be9fd]">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Section: Skills -->
    <div id="section-skills" class="modal-section hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {portfolioData.skillCategories.map((cat) => (
          <div class="bg-[#282a36] border border-[#44475a] p-4 rounded-2xl">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-2.5" style={`color: ${cat.color};`}>
              {cat.category}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {cat.skills.map((skill) => (
                <span class="text-xs px-2.5 py-1 rounded-lg bg-[#44475a] text-[#f8f8f2]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Section: Education -->
    <div id="section-education" class="modal-section hidden space-y-4">
      {portfolioData.education.map((edu) => (
        <div class="bg-[#282a36] border border-[#44475a] p-4 sm:p-5 rounded-2xl">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h3 class="font-bold text-base text-[#8be9fd]">{edu.degree}</h3>
            <span class="text-xs font-mono text-[#6272a4]">{edu.period}</span>
          </div>
          <p class="text-xs text-[#f8f8f2] mt-1">{edu.institution}</p>
          <p class="text-xs text-[#50fa7b] font-bold mt-1">Cumulative GPA: {edu.gpa}</p>
          {edu.notes && <p class="text-[11px] text-[#6272a4] mt-0.5">{edu.notes}</p>}
        </div>
      ))}

      <div class="bg-[#282a36] border border-[#44475a] p-4 sm:p-5 rounded-2xl">
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#bd93f9] mb-3">
          Professional Certifications
        </h4>
        <ul class="text-xs space-y-2.5">
          {portfolioData.certifications.map((cert) => (
            <li class="text-[#f8f8f2] flex flex-col sm:flex-row sm:justify-between gap-1 pb-2 border-b border-[#343746] last:border-0 last:pb-0">
              <span class="font-semibold">{cert.name}</span>
              <span class="text-[11px] text-[#8be9fd]">{cert.issuer} ({cert.year})</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-[#282a36] border border-[#44475a] p-4 rounded-2xl">
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#ff79c6] mb-2">Languages</h4>
        <div class="flex flex-wrap gap-2 text-xs">
          {portfolioData.languages.map((lang) => (
            <span class="px-3 py-1 rounded-xl bg-[#44475a] text-[#f8f8f2]">
              <strong class="text-[#50fa7b]">{lang.language}:</strong> {lang.proficiency}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Section: Contact -->
    <div id="section-contact" class="modal-section hidden space-y-4">
      <div class="bg-[#282a36] border border-[#44475a] p-5 rounded-2xl">
        <h3 class="font-bold text-lg text-[#50fa7b]">{portfolioData.contact.name}</h3>
        <p class="text-xs text-[#bd93f9] font-medium">{portfolioData.contact.role}</p>
        <p class="text-xs text-[#6272a4] mt-0.5">{portfolioData.contact.location}</p>
        <p class="text-xs text-[#f8f8f2] leading-relaxed mt-3 pt-3 border-t border-[#44475a]">
          {portfolioData.contact.summary}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <a
          href={`mailto:${portfolioData.contact.email}`}
          class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#bd93f9] text-[#282a36] font-bold text-xs hover:brightness-110 transition-all text-center"
        >
          <span>✉️</span>
          <span>Kirim Email</span>
        </a>
        <a
          href={portfolioData.contact.linkedin}
          target="_blank"
          rel="noreferrer"
          class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#282a36] border border-[#44475a] text-[#8be9fd] font-bold text-xs hover:bg-[#44475a] transition-all text-center"
        >
          <span>🔗</span>
          <span>LinkedIn</span>
        </a>
        <a
          href={portfolioData.contact.github}
          target="_blank"
          rel="noreferrer"
          class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#282a36] border border-[#44475a] text-[#50fa7b] font-bold text-xs hover:bg-[#44475a] transition-all text-center"
        >
          <span>🐙</span>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Section: Controls Help -->
    <div id="section-help" class="modal-section hidden space-y-4">
      <div class="bg-[#282a36] border border-[#44475a] p-4 rounded-2xl">
        <h3 class="text-sm font-bold text-[#50fa7b] mb-2">Cara Mengendalikan Mobil</h3>
        <ul class="text-xs space-y-2 text-[#f8f8f2]">
          <li class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-[#44475a] font-mono text-[#8be9fd]">W / A / S / D</span>
            <span>atau tombol panah keyboard untuk mengemudi mobil.</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-[#44475a] font-mono text-[#8be9fd]">Space / Enter</span>
            <span>Buka informasi zona saat berada di dekat platform.</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-[#44475a] font-mono text-[#8be9fd]">Esc</span>
            <span>Tutup dialog modal dan kembali mengemudi.</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-[#44475a] font-mono text-[#50fa7b]">Dock Bawah</span>
            <span>Mode cepat untuk recruiter (klik langsung lompat ke zona tanpa mengemudi).</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
