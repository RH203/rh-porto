---
---

<div
  id="mobile-controls"
  class="fixed inset-x-0 bottom-20 sm:bottom-24 z-20 pointer-events-none flex justify-between items-end px-3 sm:px-8 select-none"
>
  {/* Left Controls Box */}
  <div class="pointer-events-auto flex flex-col items-start gap-2">
    {/* Mode Switcher Tabs */}
    <div class="flex items-center bg-[#282a36]/90 p-1 rounded-xl border border-[#44475a] shadow backdrop-blur-xs gap-1">
      <button
        id="mode-joystick-btn"
        type="button"
        class="ctrl-mode-tab px-2.5 py-1 rounded-lg text-[11px] font-bold bg-[#bd93f9] text-[#282a36] shadow transition-colors"
      >
        🕹️ Joystick
      </button>
      <button
        id="mode-wheel-btn"
        type="button"
        class="ctrl-mode-tab px-2.5 py-1 rounded-lg text-[11px] font-bold text-[#6272a4] hover:text-[#f8f8f2] transition-colors"
      >
        🏎️ Setir
      </button>
      <button
        id="mode-dpad-btn"
        type="button"
        class="ctrl-mode-tab px-2.5 py-1 rounded-lg text-[11px] font-bold text-[#6272a4] hover:text-[#f8f8f2] transition-colors"
      >
        🎛️ D-Pad
      </button>
    </div>

    {/* Option 1: Virtual Analog Joystick Panel */}
    <div
      id="panel-joystick"
      class="w-36 h-36 rounded-full bg-[#343746]/90 border-2 border-[#44475a] relative flex items-center justify-center shadow-2xl backdrop-blur-xs touch-none cursor-pointer"
    >
      <!-- Center resting crosshair -->
      <div class="w-8 h-8 rounded-full border border-dashed border-[#6272a4]/50 pointer-events-none"></div>

      <!-- Movable Knob -->
      <div
        id="joystick-knob"
        class="w-14 h-14 rounded-full bg-gradient-to-br from-[#bd93f9] to-[#6272a4] border-2 border-[#f8f8f2] shadow-xl absolute transition-transform duration-75 flex items-center justify-center text-xs pointer-events-none"
      >
        🚗
      </div>
    </div>

    {/* Option 2: Interactive Steering Wheel Panel */}
    <div
      id="panel-wheel"
      class="hidden w-36 h-36 rounded-full bg-[#343746]/90 border-2 border-[#44475a] relative items-center justify-center shadow-2xl backdrop-blur-xs touch-none select-none cursor-grab active:cursor-grabbing"
    >
      <!-- Rotatable Steering Wheel SVG -->
      <div
        id="steering-wheel"
        class="w-32 h-32 relative flex items-center justify-center transition-transform duration-75 origin-center"
      >
        <svg viewBox="0 0 100 100" class="w-full h-full pointer-events-none drop-shadow-lg">
          <!-- Outer Rim -->
          <circle cx="50" cy="50" r="44" fill="none" stroke="#21222c" stroke-width="8.5" />
          <circle cx="50" cy="50" r="44" fill="none" stroke="#bd93f9" stroke-width="2.5" />
          
          <!-- Top Yellow Racing Stripe (12 o'clock marker) -->
          <rect x="47" y="1.5" width="6" height="8.5" rx="2" fill="#f1fa8c" />

          <!-- Center Horn Hub -->
          <circle cx="50" cy="50" r="16" fill="#343746" stroke="#44475a" stroke-width="2.5" />
          <circle cx="50" cy="50" r="11" fill="#282a36" />
          <text x="50" y="53.5" text-anchor="middle" font-size="8.5" font-weight="900" fill="#50fa7b">RF</text>

          <!-- 3-Spoke Sport Arms -->
          <path d="M 34 50 L 8 50" stroke="#44475a" stroke-width="6.5" stroke-linecap="round" />
          <path d="M 66 50 L 92 50" stroke="#44475a" stroke-width="6.5" stroke-linecap="round" />
          <path d="M 50 66 L 50 92" stroke="#44475a" stroke-width="6.5" stroke-linecap="round" />
        </svg>
      </div>
      <!-- Center angle hint -->
      <div id="wheel-angle-hint" class="absolute bottom-1 text-[9px] font-mono text-[#8be9fd] pointer-events-none">
        0°
      </div>
    </div>

    {/* Option 3: Retro D-Pad Panel */}
    <div
      id="panel-dpad"
      class="hidden grid-cols-3 gap-1.5 w-36 h-36 bg-[#343746]/90 p-2 rounded-3xl border-2 border-[#44475a] backdrop-blur-xs shadow-xl"
    >
      <div></div>
      <button
        id="ctrl-forward"
        type="button"
        class="ctrl-touch-btn flex items-center justify-center rounded-2xl bg-[#282a36] active:bg-[#bd93f9] text-[#f8f8f2] active:text-[#282a36] font-bold text-lg border border-[#44475a] shadow select-none"
        aria-label="Gas / Forward"
      >
        ▲
      </button>
      <div></div>

      <button
        id="ctrl-left"
        type="button"
        class="ctrl-touch-btn flex items-center justify-center rounded-2xl bg-[#282a36] active:bg-[#bd93f9] text-[#f8f8f2] active:text-[#282a36] font-bold text-lg border border-[#44475a] shadow select-none"
        aria-label="Steer Left"
      >
        ◀
      </button>
      <div class="flex items-center justify-center text-[10px] text-[#6272a4] font-mono">DRIVE</div>
      <button
        id="ctrl-right"
        type="button"
        class="ctrl-touch-btn flex items-center justify-center rounded-2xl bg-[#282a36] active:bg-[#bd93f9] text-[#f8f8f2] active:text-[#282a36] font-bold text-lg border border-[#44475a] shadow select-none"
        aria-label="Steer Right"
      >
        ▶
      </button>

      <div></div>
      <button
        id="ctrl-backward"
        type="button"
        class="ctrl-touch-btn flex items-center justify-center rounded-2xl bg-[#282a36] active:bg-[#bd93f9] text-[#f8f8f2] active:text-[#282a36] font-bold text-lg border border-[#44475a] shadow select-none"
        aria-label="Reverse"
      >
        ▼
      </button>
      <div></div>
    </div>
  </div>

  {/* Center Pedals (Visible in Wheel mode or customizable) */}
  <div id="pedal-station" class="hidden pointer-events-auto items-end gap-2.5 pb-1">
    <!-- Brake & Reverse Pedal -->
    <button
      id="ctrl-brake-pedal"
      type="button"
      class="flex flex-col items-center justify-center w-14 h-20 rounded-2xl bg-[#282a36]/95 border-2 border-[#ff5555]/60 active:border-[#ff5555] active:bg-[#ff5555]/25 text-[#f8f8f2] shadow-2xl active:scale-95 transition-all select-none backdrop-blur-xs"
      title="Pedal Rem / Mundur"
      aria-label="Pedal Rem / Mundur"
    >
      <span class="text-base">🛑</span>
      <span class="text-[9px] font-black tracking-wider text-[#ff5555] uppercase mt-0.5">REM</span>
      <div class="w-8 h-1 bg-[#ff5555]/40 rounded-full mt-1"></div>
      <div class="w-8 h-1 bg-[#ff5555]/40 rounded-full mt-0.5"></div>
    </button>

    <!-- Accelerator Gas Pedal -->
    <button
      id="ctrl-gas-pedal"
      type="button"
      class="flex flex-col items-center justify-center w-14 h-28 rounded-2xl bg-[#282a36]/95 border-2 border-[#50fa7b]/60 active:border-[#50fa7b] active:bg-[#50fa7b]/25 text-[#f8f8f2] shadow-2xl active:scale-95 transition-all select-none backdrop-blur-xs"
      title="Pedal Gas (Akselerasi)"
      aria-label="Pedal Gas"
    >
      <span class="text-lg">⚡</span>
      <span class="text-[10px] font-black tracking-wider text-[#50fa7b] uppercase mt-0.5">GAS</span>
      <div class="w-8 h-1 bg-[#50fa7b]/40 rounded-full mt-1"></div>
      <div class="w-8 h-1 bg-[#50fa7b]/40 rounded-full mt-0.5"></div>
      <div class="w-8 h-1 bg-[#50fa7b]/40 rounded-full mt-0.5"></div>
    </button>
  </div>

  {/* Right Controls: Action, Horn, Lights, Jump, Boost */}
  <div class="pointer-events-auto flex flex-col items-end gap-2.5">
    <div class="flex items-center gap-2">
      <button
        id="ctrl-jump"
        type="button"
        class="w-12 h-12 rounded-2xl bg-[#343746]/90 border border-[#44475a] active:bg-[#ff79c6] text-[#f8f8f2] active:text-[#282a36] shadow-xl flex items-center justify-center text-lg active:scale-95 transition-transform"
        title="Lompat"
        aria-label="Lompat Mobil"
      >
        🦘
      </button>
      <button
        id="ctrl-nitro"
        type="button"
        class="w-12 h-12 rounded-2xl bg-[#343746]/90 border border-[#44475a] active:bg-[#50fa7b] text-[#f8f8f2] active:text-[#282a36] shadow-xl flex items-center justify-center text-lg active:scale-95 transition-transform"
        title="Nitro Boost"
        aria-label="Nitro Boost"
      >
        ⚡
      </button>
      <button
        id="ctrl-horn"
        type="button"
        class="w-12 h-12 rounded-2xl bg-[#343746]/90 border border-[#44475a] active:bg-[#f1fa8c] text-[#f8f8f2] active:text-[#282a36] shadow-xl flex items-center justify-center text-lg active:scale-95 transition-transform"
        title="Klakson"
        aria-label="Bunyikan Klakson"
      >
        📯
      </button>
      <button
        id="ctrl-light"
        type="button"
        class="w-12 h-12 rounded-2xl bg-[#343746]/90 border border-[#44475a] active:bg-[#ffb86c] text-[#f8f8f2] active:text-[#282a36] shadow-xl flex items-center justify-center text-lg active:scale-95 transition-transform"
        title="Lampu Malam / Siang"
        aria-label="Toggle Mode Malam"
      >
        💡
      </button>
    </div>

    {/* Primary Action Button */}
    <button
      id="ctrl-action"
      type="button"
      class="ctrl-touch-btn w-20 h-20 rounded-full bg-[#50fa7b] text-[#282a36] font-black text-sm tracking-wide shadow-2xl border-4 border-[#343746] active:scale-95 transition-transform flex flex-col items-center justify-center select-none"
      aria-label="Buka informasi"
    >
      <span class="text-xl leading-none">🔍</span>
      <span class="text-[10px] uppercase font-bold mt-1">OPEN</span>
    </button>
  </div>
</div>
