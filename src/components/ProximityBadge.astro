---
---

<div
  id="proximity-badge"
  class="fixed top-6 left-1/2 -translate-x-1/2 z-30 transition-all duration-300 transform -translate-y-24 opacity-0 pointer-events-none"
>
  <button
    id="proximity-btn"
    type="button"
    class="pointer-events-auto bg-[#343746] border-2 border-[#bd93f9] text-[#f8f8f2] px-4 py-2.5 rounded-2xl shadow-2xl flex items-center gap-3 active:scale-95 transition-transform cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#50fa7b]"
  >
    <span id="proximity-icon" class="text-2xl animate-bounce">📍</span>
    <div class="text-left">
      <div id="proximity-title" class="text-sm font-bold text-[#50fa7b]">Zone Discovered</div>
      <div class="text-[11px] text-[#f8f8f2]/80 flex items-center gap-1.5">
        <span class="hidden sm:inline bg-[#44475a] px-1.5 py-0.5 rounded text-[10px] font-mono text-[#8be9fd]">Space / Enter</span>
        <span>atau klik untuk buka info</span>
      </div>
    </div>
  </button>
</div>
