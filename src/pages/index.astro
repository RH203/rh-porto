---
import Layout from '../layouts/Layout.astro';
import RecruiterDock from '../components/RecruiterDock.astro';
import MobileControls from '../components/MobileControls.astro';
import ProximityBadge from '../components/ProximityBadge.astro';
import InfoModal from '../components/InfoModal.astro';
import WelcomeModal from '../components/WelcomeModal.astro';
import Minimap from '../components/Minimap.astro';
import { portfolioData } from '../data/portfolioData';

const pageTitle = `${portfolioData.contact.name} - 3D Interactive Portfolio`;
const pageDescription = `${portfolioData.contact.name} - ${portfolioData.contact.role}. Interactive 3D Toy Car Diorama Portfolio.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- 3D Canvas Viewport -->
  <main id="canvas-container" class="absolute inset-0 w-full h-full cursor-grab active:cursor-grabbing"></main>

  <!-- Top Left HUD: Profile Identity & Quick Toolbars -->
  <header class="fixed top-4 left-4 z-20 pointer-events-none select-none flex flex-wrap items-center gap-2">
    <!-- Profile Card -->
    <div class="pointer-events-auto bg-[#343746]/90 border border-[#44475a] px-3.5 py-2.5 rounded-2xl shadow-xl backdrop-blur-xs flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-[#bd93f9] text-[#282a36] font-black flex items-center justify-center text-sm shadow">
        RF
      </div>
      <div>
        <h1 class="text-xs sm:text-sm font-bold tracking-tight text-[#f8f8f2] leading-tight">
          {portfolioData.contact.name}
        </h1>
        <p class="text-[10px] sm:text-[11px] font-medium text-[#50fa7b] leading-tight">
          {portfolioData.contact.role}
        </p>
      </div>
    </div>

    <!-- Quick Action Toolbar -->
    <div class="pointer-events-auto bg-[#343746]/90 border border-[#44475a] p-1.5 rounded-2xl shadow-xl backdrop-blur-xs flex items-center gap-1">
      {/* Night mode toggle */}
      <button
        id="btn-night-mode"
        type="button"
        title="Beralih ke Mode Malam (Tombol L)"
        class="w-9 h-9 rounded-xl bg-[#282a36] hover:bg-[#bd93f9] hover:text-[#282a36] text-[#f8f8f2] text-sm flex items-center justify-center border border-[#44475a] transition-all"
        aria-label="Toggle Mode Siang / Malam"
      >
        ☀️
      </button>

      {/* Audio Sound FX toggle */}
      <button
        id="btn-sound-toggle"
        type="button"
        title="Toggle Suara SFX Mesin & Klakson"
        class="w-9 h-9 rounded-xl bg-[#282a36] hover:bg-[#50fa7b] hover:text-[#282a36] text-[#f8f8f2] text-sm flex items-center justify-center border border-[#44475a] transition-all"
        aria-label="Toggle Suara"
      >
        🔊
      </button>

      {/* Klakson Honk */}
      <button
        id="btn-horn"
        type="button"
        title="Bunyikan Klakson (Tombol H)"
        class="w-9 h-9 rounded-xl bg-[#282a36] hover:bg-[#f1fa8c] hover:text-[#282a36] text-[#f8f8f2] text-sm flex items-center justify-center border border-[#44475a] transition-all"
        aria-label="Bunyikan Klakson"
      >
        📯
      </button>

      {/* Car Paint Palette Toggle */}
      <div class="relative">
        <button
          id="btn-paint-toggle"
          type="button"
          title="Kustomisasi Warna Mobil"
          class="w-9 h-9 rounded-xl bg-[#282a36] hover:bg-[#ff79c6] hover:text-[#282a36] text-[#f8f8f2] text-sm flex items-center justify-center border border-[#44475a] transition-all"
          aria-label="Warna Mobil"
        >
          🎨
        </button>
        {/* Paint Swatches Popover */}
        <div
          id="paint-palette-menu"
          class="hidden absolute top-11 left-0 bg-[#282a36]/95 border border-[#44475a] p-1.5 rounded-2xl shadow-2xl backdrop-blur-md flex items-center gap-1.5 z-50 pointer-events-auto"
        >
          <button type="button" class="paint-swatch w-6 h-6 rounded-lg bg-[#bd93f9] border border-[#f8f8f2]/40 hover:scale-110 transition-transform" data-color="#bd93f9" title="Cyber Violet"></button>
          <button type="button" class="paint-swatch w-6 h-6 rounded-lg bg-[#50fa7b] border border-[#f8f8f2]/40 hover:scale-110 transition-transform" data-color="#50fa7b" title="Neon Emerald"></button>
          <button type="button" class="paint-swatch w-6 h-6 rounded-lg bg-[#ffb86c] border border-[#f8f8f2]/40 hover:scale-110 transition-transform" data-color="#ffb86c" title="Sunset Amber"></button>
          <button type="button" class="paint-swatch w-6 h-6 rounded-lg bg-[#8be9fd] border border-[#f8f8f2]/40 hover:scale-110 transition-transform" data-color="#8be9fd" title="Electric Cyan"></button>
          <button type="button" class="paint-swatch w-6 h-6 rounded-lg bg-[#ff79c6] border border-[#f8f8f2]/40 hover:scale-110 transition-transform" data-color="#ff79c6" title="Hot Pink"></button>
        </div>
      </div>

      {/* Star Collectibles Counter Badge */}
      <div
        id="star-counter-badge"
        class="flex items-center gap-1.5 px-2.5 h-9 rounded-xl bg-[#282a36] border border-[#f1fa8c]/40 text-[#f1fa8c] text-xs font-bold shadow"
        title="Kumpulkan 5 Bintang di Sirkuit Pulau"
      >
        <span>⭐</span>
        <span id="star-counter-text">0 / 5</span>
      </div>

      {/* Download Resume / CV Link */}
      <a
        id="btn-download-cv"
        href={`mailto:${portfolioData.contact.email}?subject=Recruiter%20Inquiry%20-%20Raihan%20Firdaus`}
        title="Hubungi & Request CV Lengkap"
        class="flex items-center gap-1.5 px-3 h-9 rounded-xl bg-[#50fa7b] text-[#282a36] text-xs font-bold shadow hover:brightness-110 transition-all"
      >
        <span>📄</span>
        <span class="hidden md:inline">Hire / CV</span>
      </a>
    </div>
  </header>

  <!-- Racing Speedometer HUD (Telemetry Cockpit) -->
  <div
    id="speedometer-hud"
    class="fixed bottom-2 left-1/2 -translate-x-1/2 z-20 pointer-events-none select-none hidden sm:flex items-center gap-3 bg-[#282a36]/90 border border-[#44475a] px-3.5 py-1.5 rounded-2xl shadow-2xl backdrop-blur-md"
  >
    {/* Gear Indicator */}
    <div class="flex flex-col items-center">
      <span class="text-[9px] font-mono text-[#6272a4] uppercase">GEAR</span>
      <span id="telemetry-gear" class="text-sm font-black text-[#50fa7b] font-mono leading-none">1</span>
    </div>

    <div class="h-6 w-[1px] bg-[#44475a]"></div>

    {/* Speed Gauge */}
    <div class="flex items-baseline gap-1">
      <span id="telemetry-speed" class="text-xl font-black font-mono text-[#f8f8f2] tracking-tight leading-none">0</span>
      <span class="text-[10px] font-mono font-bold text-[#8be9fd]">KM/H</span>
    </div>

    <div class="h-6 w-[1px] bg-[#44475a]"></div>

    {/* Status Badges: Drift & Nitro */}
    <div class="flex items-center gap-1">
      <span
        id="telemetry-drift"
        class="px-1.5 py-0.5 rounded text-[9px] font-black tracking-wider uppercase bg-[#ff5555]/20 text-[#ff5555] border border-[#ff5555]/40 opacity-0 transition-opacity"
      >
        DRIFT
      </span>
      <span
        id="telemetry-nitro"
        class="px-1.5 py-0.5 rounded text-[9px] font-black tracking-wider uppercase bg-[#50fa7b]/20 text-[#50fa7b] border border-[#50fa7b]/40 opacity-0 transition-opacity"
      >
        NITRO
      </span>
    </div>
  </div>

  <!-- Top Right HUD: Driving Hints -->
  <aside class="fixed top-4 right-4 z-20 pointer-events-none select-none hidden md:block">
    <div class="pointer-events-auto bg-[#343746]/90 border border-[#44475a] px-3.5 py-2.5 rounded-2xl shadow-xl backdrop-blur-xs text-[11px] text-[#f8f8f2] flex items-center gap-2.5">
      <div>
        <span class="text-[#8be9fd] font-mono font-bold">WASD</span> Setir
      </div>
      <span class="text-[#44475a]">|</span>
      <div>
        <span class="text-[#50fa7b] font-mono font-bold">Shift</span> Nitro
      </div>
      <span class="text-[#44475a]">|</span>
      <div>
        <span class="text-[#ff79c6] font-mono font-bold">Space/J</span> Lompat
      </div>
      <span class="text-[#44475a]">|</span>
      <div>
        <span class="text-[#f1fa8c] font-mono font-bold">H</span> Klakson
      </div>
      <span class="text-[#44475a]">|</span>
      <div>
        <span class="text-[#ffb86c] font-mono font-bold">L</span> Malam
      </div>
    </div>
  </aside>

  <!-- Feedback Toast Container -->
  <div
    id="toast-box"
    class="fixed top-20 right-4 z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-10px] bg-[#343746] border border-[#50fa7b] text-[#f8f8f2] px-4 py-2.5 rounded-2xl shadow-2xl flex items-center gap-2 text-xs font-semibold backdrop-blur-md"
  >
    <span id="toast-icon">✨</span>
    <span id="toast-text">Tersalin!</span>
  </div>

  <!-- Interactive Overlays -->
  <Minimap />
  <ProximityBadge />
  <RecruiterDock />
  <MobileControls />
  <InfoModal />
  <WelcomeModal />

  <!-- Bundled Client Application Script -->
  <script src="../scripts/app.ts"></script>
</Layout>
