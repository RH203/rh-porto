---
import Layout from '../layouts/Layout.astro';
import data from '../data/portfolio.json';

const { profile, projects, experience, skills, education, certifications, languages } = data;
---

<Layout title={`${profile.name} — Software Engineer`} description={profile.summary}>
  <div class="max-w-3xl mx-auto px-5 sm:px-8 py-12 sm:py-20 text-[15px] leading-relaxed text-[#141413] dark:text-[#ededeb]">

    <!-- Header Section: Personal, Direct, Human -->
    <header class="mb-14 pb-8 border-b border-[#e5e4de] dark:border-[#24252a]">
      <div class="flex items-start justify-between gap-4 mb-3">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#141413] dark:text-[#ededeb]">
            {profile.name}
          </h1>
          <p class="text-sm sm:text-base text-[#6b6a67] dark:text-[#9c9b98] mt-1 font-medium">
            {profile.role}
          </p>
        </div>

        <!-- Subtle Theme Toggle -->
        <button
          type="button"
          id="btn-theme-toggle"
          class="text-xs font-mono px-2.5 py-1 rounded border border-[#e5e4de] dark:border-[#24252a] text-[#6b6a67] dark:text-[#9c9b98] hover:text-[#141413] dark:hover:text-[#ededeb] hover:bg-[#f3f2ee] dark:hover:bg-[#18191e] transition-colors cursor-pointer"
          aria-label="Ganti mode tampilan"
        >
          <span class="dark:hidden">Dark mode</span>
          <span class="hidden dark:inline">Light mode</span>
        </button>
      </div>

      <!-- Human Summary Bio -->
      <p class="text-[#3c3b37] dark:text-[#c4c3be] mt-4 leading-relaxed">
        {profile.summary}
      </p>

      <!-- Simple Text Meta & Contact Links -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-5 text-xs text-[#6b6a67] dark:text-[#9c9b98] font-mono">
        <span>Surabaya, Indonesia</span>
        <span class="text-[#d4d3cc] dark:text-[#383a42]">/</span>
        <a
          href={`mailto:${profile.email}`}
          class="text-[#141413] dark:text-[#ededeb] hover:underline underline-offset-4"
        >
          {profile.email}
        </a>
        <button
          type="button"
          id="btn-copy-email"
          data-email={profile.email}
          class="text-[#6b6a67] dark:text-[#9c9b98] hover:text-[#141413] dark:hover:text-[#ededeb] cursor-pointer"
        >
          (salin)
        </button>
        <span class="text-[#d4d3cc] dark:text-[#383a42]">/</span>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#141413] dark:text-[#ededeb] hover:underline underline-offset-4"
        >
          GitHub
        </a>
        <span class="text-[#d4d3cc] dark:text-[#383a42]">/</span>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#141413] dark:text-[#ededeb] hover:underline underline-offset-4"
        >
          LinkedIn
        </a>
      </div>
    </header>

    <!-- Navigation Jump Bar (Quiet & Textual) -->
    <nav class="flex items-center gap-5 text-xs font-mono uppercase tracking-wider text-[#6b6a67] dark:text-[#9c9b98] mb-12" aria-label="Daftar Bagian">
      <a href="#proyek" class="hover:text-[#141413] dark:hover:text-[#ededeb] transition-colors">01. Proyek</a>
      <a href="#pengalaman" class="hover:text-[#141413] dark:hover:text-[#ededeb] transition-colors">02. Pengalaman</a>
      <a href="#keahlian" class="hover:text-[#141413] dark:hover:text-[#ededeb] transition-colors">03. Stack</a>
      <a href="#kredensial" class="hover:text-[#141413] dark:hover:text-[#ededeb] transition-colors">04. Kredensial</a>
    </nav>

    <!-- SECTION 1: SELECTED PROJECTS -->
    <section id="proyek" class="mb-16">
      <div class="flex items-baseline justify-between mb-8 pb-2 border-b border-[#e5e4de] dark:border-[#24252a]">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#6b6a67] dark:text-[#9c9b98]">
          01 / Proyek Rekayasa Terpilih
        </h2>
        <span class="text-xs font-mono text-[#999893] dark:text-[#6e6d6a]">{projects.length} Sistem</span>
      </div>

      <div class="space-y-12">
        {projects.map((proj, idx) => (
          <article class="space-y-3.5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-bold tracking-tight text-[#141413] dark:text-[#ededeb]">
                {proj.title}
              </h3>
              <span class="text-xs font-mono text-[#6b6a67] dark:text-[#9c9b98]">{proj.period}</span>
            </div>

            <p class="text-xs font-mono text-[#6b6a67] dark:text-[#9c9b98]">
              {proj.role} — {proj.subtitle}
            </p>

            <p class="text-[#3c3b37] dark:text-[#c4c3be]">
              {proj.description}
            </p>

            <!-- Technical Challenge & Solution Note -->
            <div class="pl-3.5 border-l-2 border-[#e5e4de] dark:border-[#24252a] text-xs space-y-1.5 text-[#555450] dark:text-[#a8a7a2]">
              <p><strong class="font-semibold text-[#141413] dark:text-[#ededeb]">Tantangan:</strong> {proj.challenge}</p>
              <p><strong class="font-semibold text-[#141413] dark:text-[#ededeb]">Solusi Arsitektur:</strong> {proj.solution}</p>
            </div>

            <!-- Real Implementation Highlights -->
            <ul class="space-y-1.5 text-xs text-[#3c3b37] dark:text-[#c4c3be] pt-1">
              {proj.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <span class="text-[#999893] dark:text-[#6e6d6a] select-none">-</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <!-- Tech Stack Tags & Repo Link -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <div class="flex flex-wrap gap-1.5">
                {proj.tags.map((t) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#f3f2ee] dark:bg-[#18191e] text-[#555450] dark:text-[#a8a7a2] border border-[#e5e4de] dark:border-[#24252a]">
                    {t}
                  </span>
                ))}
              </div>

              {proj.githubUrl && (
                <a
                  href={proj.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-mono text-[#141413] dark:text-[#ededeb] hover:underline underline-offset-4 flex items-center gap-1"
                >
                  <span>Repository</span>
                  <span class="text-[10px]">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 2: WORK EXPERIENCE -->
    <section id="pengalaman" class="mb-16">
      <div class="flex items-baseline justify-between mb-8 pb-2 border-b border-[#e5e4de] dark:border-[#24252a]">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#6b6a67] dark:text-[#9c9b98]">
          02 / Pengalaman Kerja
        </h2>
        <span class="text-xs font-mono text-[#999893] dark:text-[#6e6d6a]">{experience.length} Posisi</span>
      </div>

      <div class="space-y-10">
        {experience.map((exp) => (
          <article class="space-y-2.5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-base font-bold text-[#141413] dark:text-[#ededeb]">
                {exp.role} <span class="font-normal text-[#6b6a67] dark:text-[#9c9b98]">di</span> {exp.company}
              </h3>
              <span class="text-xs font-mono text-[#6b6a67] dark:text-[#9c9b98]">{exp.period}</span>
            </div>

            <p class="text-xs font-mono text-[#6b6a67] dark:text-[#9c9b98]">
              {exp.location}
            </p>

            <p class="text-xs text-[#555450] dark:text-[#a8a7a2]">
              {exp.summary}
            </p>

            <ul class="space-y-1.5 text-xs text-[#3c3b37] dark:text-[#c4c3be] pt-1">
              {exp.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="text-[#999893] dark:text-[#6e6d6a] select-none">-</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-1.5 pt-1">
              {exp.techStack.map((t) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#f3f2ee] dark:bg-[#18191e] text-[#555450] dark:text-[#a8a7a2] border border-[#e5e4de] dark:border-[#24252a]">
                  {t}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 3: TECHNICAL SKILLS & STACK -->
    <section id="keahlian" class="mb-16">
      <div class="flex items-baseline justify-between mb-8 pb-2 border-b border-[#e5e4de] dark:border-[#24252a]">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#6b6a67] dark:text-[#9c9b98]">
          03 / Instrumen & Keahlian Teknis
        </h2>
        <span class="text-xs font-mono text-[#999893] dark:text-[#6e6d6a]">Index Stack</span>
      </div>

      <div class="space-y-6">
        {skills.map((cat) => (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pb-4 border-b border-[#e5e4de]/60 dark:border-[#24252a]/60">
            <div>
              <h3 class="text-xs font-bold text-[#141413] dark:text-[#ededeb]">{cat.category}</h3>
              <p class="text-[11px] text-[#6b6a67] dark:text-[#9c9b98] mt-0.5">{cat.description}</p>
            </div>
            <div class="sm:col-span-2 flex flex-wrap gap-1.5 items-center">
              {cat.items.map((item) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-[#f3f2ee] dark:bg-[#18191e] text-[#3c3b37] dark:text-[#c4c3be] border border-[#e5e4de] dark:border-[#24252a]">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 4: EDUCATION & CREDENTIALS -->
    <section id="kredensial" class="mb-16">
      <div class="flex items-baseline justify-between mb-8 pb-2 border-b border-[#e5e4de] dark:border-[#24252a]">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#6b6a67] dark:text-[#9c9b98]">
          04 / Pendidikan & Kredensial
        </h2>
        <span class="text-xs font-mono text-[#999893] dark:text-[#6e6d6a]">Latar Belakang</span>
      </div>

      <div class="space-y-6">
        <!-- Education -->
        <div class="space-y-1">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-sm font-bold text-[#141413] dark:text-[#ededeb]">
              {education[0].institution}
            </h3>
            <span class="text-xs font-mono text-[#6b6a67] dark:text-[#9c9b98]">{education[0].period}</span>
          </div>
          <p class="text-xs text-[#3c3b37] dark:text-[#c4c3be]">
            {education[0].degree} — IPK: <span class="font-bold text-[#141413] dark:text-[#ededeb]">{education[0].gpa}</span>
          </p>
          <p class="text-[11px] text-[#6b6a67] dark:text-[#9c9b98]">{education[0].notes}</p>
        </div>

        <!-- Certifications -->
        <div class="pt-4 border-t border-[#e5e4de]/60 dark:border-[#24252a]/60 space-y-2.5">
          <h3 class="text-xs font-mono uppercase text-[#6b6a67] dark:text-[#9c9b98]">Sertifikasi</h3>
          <ul class="space-y-2 text-xs text-[#3c3b37] dark:text-[#c4c3be]">
            {certifications.map((c) => (
              <li class="flex items-baseline justify-between gap-3">
                <span>{c.name} ({c.issuer})</span>
                <span class="text-xs font-mono text-[#999893] dark:text-[#6e6d6a] shrink-0">{c.year}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Languages -->
        <div class="pt-4 border-t border-[#e5e4de]/60 dark:border-[#24252a]/60 space-y-2">
          <h3 class="text-xs font-mono uppercase text-[#6b6a67] dark:text-[#9c9b98]">Bahasa</h3>
          <div class="flex flex-wrap gap-4 text-xs text-[#3c3b37] dark:text-[#c4c3be]">
            {languages.map((l) => (
              <span>
                <strong class="font-semibold text-[#141413] dark:text-[#ededeb]">{l.language}:</strong> {l.proficiency}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Minimalist Quiet Footer -->
    <footer class="pt-8 border-t border-[#e5e4de] dark:border-[#24252a] text-xs font-mono text-[#6b6a67] dark:text-[#9c9b98] flex flex-wrap items-center justify-between gap-3">
      <span>{profile.name} · Surabaya, Indonesia</span>
      <div class="flex items-center gap-3">
        <a href={`mailto:${profile.email}`} class="hover:text-[#141413] dark:hover:text-[#ededeb]">Hubungi</a>
        <span>·</span>
        <a href="#proyek" class="hover:text-[#141413] dark:hover:text-[#ededeb]">Kembali ke atas ↑</a>
      </div>
    </footer>

    <!-- Non-intrusive Copy Toast -->
    <div
      id="copy-toast"
      class="fixed bottom-6 right-6 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-150 bg-[#141413] text-[#faf9f6] dark:bg-[#ededeb] dark:text-[#111215] px-3.5 py-2 rounded text-xs font-mono"
      role="status"
    >
      Email disalin ke clipboard
    </div>

  </div>

  <!-- Client-side Minimal Controller -->
  <script is:inline>
    (function () {
      const themeToggle = document.getElementById('btn-theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      const copyBtn = document.getElementById('btn-copy-email');
      const copyToast = document.getElementById('copy-toast');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const email = copyBtn.getAttribute('data-email');
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
            if (copyToast) {
              copyToast.classList.remove('opacity-0', 'translate-y-2');
              copyToast.classList.add('opacity-100', 'translate-y-0');
              setTimeout(() => {
                copyToast.classList.remove('opacity-100', 'translate-y-0');
                copyToast.classList.add('opacity-0', 'translate-y-2');
              }, 2000);
            }
          } catch (e) {
            console.error(e);
          }
        });
      }
    })();
  </script>
</Layout>
