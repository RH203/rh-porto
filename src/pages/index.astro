---
import Layout from '../layouts/Layout.astro';
import data from '../data/portfolio.json';

const { profile, stats, projects, experience, skills, education, certifications, languages } = data;
---

<Layout title={`${profile.name}: Software Engineer`} description={profile.summary}>
  <!-- Top Ambient Subtlety (R-01: hierarchy separation, capped accent) -->
  <div class="fixed top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-emerald-500/30 to-transparent pointer-events-none z-50"></div>

  <!-- Persistent Header & Nav Dock -->
  <header class="sticky top-0 z-40 backdrop-blur-md bg-[#f8f9fa]/90 dark:bg-[#090a0c]/90 border-b border-[#e4e7eb] dark:border-[#222630] transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
      <!-- Monogram Logo -->
      <a
        href="#"
        class="flex items-center gap-2 group text-xs font-mono font-semibold tracking-tight text-[#0f141c] dark:text-[#f4f5f7]"
        aria-label="Ke atas halaman"
      >
        <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-[#e9ecef] dark:bg-[#181b21] border border-[#cbd2d9] dark:border-[#323846] text-[#0f141c] dark:text-[#f4f5f7] group-hover:border-emerald-500 transition-colors">
          RF
        </span>
        <span class="hidden sm:inline text-[#6b7280] dark:text-[#9ca3af]">/</span>
        <span class="hidden sm:inline">Raihan Firdaus</span>
      </a>

      <!-- Jump Navigation -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]" aria-label="Navigasi Halaman">
        <a href="#proyek" class="hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-colors">01. Proyek</a>
        <a href="#pengalaman" class="hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-colors">02. Pengalaman</a>
        <a href="#stack" class="hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-colors">03. Stack</a>
        <a href="#kredensial" class="hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-colors">04. Kredensial</a>
      </nav>

      <!-- Action Utilities: Theme Toggle & Quick Contact -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-copy-nav"
          data-email={profile.email}
          class="text-xs font-mono px-2.5 py-1.5 rounded-md border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] hover:bg-[#f1f3f5] dark:hover:bg-[#181b21] text-[#4b5563] dark:text-[#9ca3af] hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-all flex items-center gap-1.5 cursor-pointer"
          title="Salin email ke clipboard"
          aria-label="Salin alamat email"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span class="hidden sm:inline">Salin Email</span>
        </button>

        <button
          type="button"
          id="btn-theme-toggle"
          class="p-1.5 rounded-md border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] hover:bg-[#f1f3f5] dark:hover:bg-[#181b21] text-[#4b5563] dark:text-[#9ca3af] hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-all cursor-pointer"
          aria-label="Ganti mode tampilan tema"
        >
          <!-- Moon icon for light mode -->
          <svg class="w-4 h-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
          <!-- Sun icon for dark mode -->
          <svg class="w-4 h-4 hidden dark:inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/>
            <path d="M12 20v2"/>
            <path d="m4.93 4.93 1.41 1.41"/>
            <path d="m17.66 17.66 1.41 1.41"/>
            <path d="M2 12h2"/>
            <path d="M20 12h2"/>
            <path d="m6.34 17.66-1.41 1.41"/>
            <path d="m19.07 4.93-1.41 1.41"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16 text-[#0f141c] dark:text-[#f4f5f7]">

    <!-- HERO SECTION -->
    <section class="mb-14 sm:mb-20">
      <!-- Live Status Pill (R-09: functional status, R-13: capped pulse) -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 status-pulse-beacon"></span>
        <span>{profile.status}</span>
      </div>

      <!-- Identity & Role -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#0f141c] dark:text-[#f4f5f7] leading-[1.15]">
          {profile.name}
        </h1>
        <p class="text-base sm:text-xl font-medium text-[#4b5563] dark:text-[#9ca3af] max-w-2xl leading-normal">
          {profile.role}
        </p>
      </div>

      <!-- Human Summary Narrative -->
      <p class="mt-6 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db] max-w-3xl">
        {profile.summary}
      </p>

      <!-- Location and Direct Links -->
      <div class="mt-8 flex flex-wrap items-center gap-3 text-xs font-mono">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#e9ecef] dark:bg-[#181b21] border border-[#e4e7eb] dark:border-[#222630] text-[#4b5563] dark:text-[#9ca3af]">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {profile.location}
        </span>

        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#0f141c] text-[#f8f9fa] dark:bg-[#f4f5f7] dark:text-[#090a0c] font-semibold hover:opacity-90 transition-opacity"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span>Hubungi Langsung</span>
        </a>

        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white dark:bg-[#111317] border border-[#e4e7eb] dark:border-[#222630] text-[#4b5563] dark:text-[#9ca3af] hover:text-[#0f141c] dark:hover:text-[#f4f5f7] hover:border-[#cbd2d9] dark:hover:border-[#323846] transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white dark:bg-[#111317] border border-[#e4e7eb] dark:border-[#222630] text-[#4b5563] dark:text-[#9ca3af] hover:text-[#0f141c] dark:hover:text-[#f4f5f7] hover:border-[#cbd2d9] dark:hover:border-[#323846] transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </section>

    <!-- REAL ENGINEERING TELEMETRY METRICS (R-17 / C-5: No fake stats, verified data only) -->
    <section class="mb-16 sm:mb-24" aria-label="Metrik Rekayasa Terverifikasi">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {stats.map((item) => (
          <div class="p-4 rounded-xl border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-colors">
            <span class="block text-xl sm:text-2xl font-bold font-mono tracking-tight text-[#0f141c] dark:text-[#f4f5f7]">
              {item.value}
            </span>
            <span class="block mt-1 text-xs font-semibold text-[#374151] dark:text-[#d1d5db]">
              {item.label}
            </span>
            <span class="block mt-0.5 text-[11px] text-[#6b7280] dark:text-[#9ca3af] leading-tight">
              {item.detail}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 1: SELECTED PROJECTS WITH INTERACTIVE TABS -->
    <section id="proyek" class="mb-16 sm:mb-24 scroll-mt-20">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-[#e4e7eb] dark:border-[#222630]">
        <div>
          <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400">01 / REKAYASA SISTEM</span>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#0f141c] dark:text-[#f4f5f7] mt-0.5">
            Proyek Unggulan Terpilih
          </h2>
        </div>
        <span class="text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
          {projects.length} Arsitektur Produksi
        </span>
      </div>

      <!-- Project Showcase Cards -->
      <div class="space-y-8">
        {projects.map((proj) => (
          <article class="p-5 sm:p-7 rounded-2xl border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] hover:border-[#cbd2d9] dark:hover:border-[#323846] transition-all">
            <!-- Project Header -->
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b border-[#f1f3f5] dark:border-[#181b21]">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-[#0f141c] dark:text-[#f4f5f7] tracking-tight">
                  {proj.title}
                </h3>
                <p class="text-xs font-mono text-[#4b5563] dark:text-[#9ca3af] mt-1">
                  <span class="text-emerald-600 dark:text-emerald-400 font-medium">{proj.role}</span>
                  <span class="mx-1.5 text-[#cbd2d9] dark:text-[#323846]">•</span>
                  <span>{proj.subtitle}</span>
                </p>
              </div>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-[#f1f3f5] dark:bg-[#181b21] border border-[#e4e7eb] dark:border-[#222630] text-[#6b7280] dark:text-[#9ca3af] self-start sm:self-auto">
                {proj.period}
              </span>
            </div>

            <!-- Description -->
            <p class="mt-4 text-xs sm:text-sm text-[#374151] dark:text-[#d1d5db] leading-relaxed">
              {proj.description}
            </p>

            <!-- Interactive Tab System for Deep Technical Inspection -->
            <div class="mt-6 project-tab-group" data-project-id={proj.id}>
              <!-- Tab Navigation Buttons -->
              <div class="flex items-center gap-1.5 p-1 rounded-lg bg-[#f1f3f5] dark:bg-[#181b21] border border-[#e4e7eb] dark:border-[#222630] text-xs font-mono w-fit max-w-full overflow-x-auto">
                <button
                  type="button"
                  data-tab="architecture"
                  class="tab-btn active px-3 py-1 rounded-md text-[#0f141c] dark:text-[#f4f5f7] bg-white dark:bg-[#111317] shadow-sm font-semibold transition-all cursor-pointer"
                >
                  Arsitektur & Solusi
                </button>
                <button
                  type="button"
                  data-tab="highlights"
                  class="tab-btn px-3 py-1 rounded-md text-[#6b7280] dark:text-[#9ca3af] hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-all cursor-pointer"
                >
                  Sorotan Rekayasa
                </button>
                <button
                  type="button"
                  data-tab="stack"
                  class="tab-btn px-3 py-1 rounded-md text-[#6b7280] dark:text-[#9ca3af] hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-all cursor-pointer"
                >
                  Tech Stack
                </button>
              </div>

              <!-- Tab Panel 1: Architecture Challenge & Solution -->
              <div class="tab-panel tab-panel-architecture mt-4 space-y-3 p-4 rounded-xl bg-[#f8f9fa] dark:bg-[#090a0c] border border-[#e4e7eb] dark:border-[#222630] text-xs">
                <div class="space-y-1">
                  <span class="font-mono font-bold text-amber-700 dark:text-amber-400 uppercase tracking-wider text-[10px]">
                    Tantangan Teknis
                  </span>
                  <p class="text-[#374151] dark:text-[#d1d5db] leading-relaxed">
                    {proj.challenge}
                  </p>
                </div>
                <div class="pt-2 border-t border-[#e4e7eb] dark:border-[#222630] space-y-1">
                  <span class="font-mono font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider text-[10px]">
                    Solusi Rekayasa
                  </span>
                  <p class="text-[#374151] dark:text-[#d1d5db] leading-relaxed">
                    {proj.solution}
                  </p>
                </div>
              </div>

              <!-- Tab Panel 2: Highlights List -->
              <div class="tab-panel tab-panel-highlights hidden mt-4 p-4 rounded-xl bg-[#f8f9fa] dark:bg-[#090a0c] border border-[#e4e7eb] dark:border-[#222630] text-xs">
                <ul class="space-y-2 text-[#374151] dark:text-[#d1d5db]">
                  {proj.highlights.map((h) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tab Panel 3: Stack Tags -->
              <div class="tab-panel tab-panel-stack hidden mt-4 p-4 rounded-xl bg-[#f8f9fa] dark:bg-[#090a0c] border border-[#e4e7eb] dark:border-[#222630] text-xs">
                <div class="flex flex-wrap gap-2">
                  {proj.tags.map((t) => (
                    <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white dark:bg-[#111317] border border-[#e4e7eb] dark:border-[#222630] text-[#374151] dark:text-[#d1d5db]">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- External Action Link -->
            {proj.githubUrl && (
              <div class="mt-5 pt-4 border-t border-[#f1f3f5] dark:border-[#181b21] flex justify-end">
                <a
                  href={proj.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-[#0f141c] dark:text-[#f4f5f7] hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
                >
                  <span>Buka Repository Proyek</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 7h10v10"/>
                    <path d="M7 17 17 7"/>
                  </svg>
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 2: WORK EXPERIENCE TIMELINE -->
    <section id="pengalaman" class="mb-16 sm:mb-24 scroll-mt-20">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-[#e4e7eb] dark:border-[#222630]">
        <div>
          <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400">02 / REKAM JEJAK</span>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#0f141c] dark:text-[#f4f5f7] mt-0.5">
            Pengalaman Rekayasa
          </h2>
        </div>
        <span class="text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
          {experience.length} Organisasi
        </span>
      </div>

      <!-- Timeline Entries -->
      <div class="relative pl-6 sm:pl-8 space-y-10 sm:space-y-12 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-px before:bg-[#e4e7eb] dark:before:bg-[#222630]">
        {experience.map((exp) => (
          <article class="relative space-y-3">
            <!-- Timeline Indicator Node -->
            <div class="absolute -left-6 sm:-left-8 top-1.5 w-4 h-4 rounded-full bg-white dark:bg-[#090a0c] border-2 border-emerald-500 flex items-center justify-center">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h3 class="text-base sm:text-lg font-bold text-[#0f141c] dark:text-[#f4f5f7]">
                {exp.role} <span class="font-normal text-[#6b7280] dark:text-[#9ca3af]">di</span> <span class="text-emerald-700 dark:text-emerald-400 font-semibold">{exp.company}</span>
              </h3>
              <span class="text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
                {exp.period}
              </span>
            </div>

            <p class="text-xs font-mono text-[#4b5563] dark:text-[#9ca3af]">
              {exp.location}
            </p>

            <p class="text-xs sm:text-sm text-[#374151] dark:text-[#d1d5db] font-medium leading-relaxed">
              {exp.summary}
            </p>

            <ul class="space-y-2 text-xs text-[#4b5563] dark:text-[#9ca3af] pt-1">
              {exp.bullets.map((b) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#cbd2d9] dark:bg-[#323846] shrink-0 mt-1.5"></span>
                  <span class="leading-relaxed">{b}</span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-1.5 pt-2">
              {exp.techStack.map((t) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#f1f3f5] dark:bg-[#181b21] border border-[#e4e7eb] dark:border-[#222630] text-[#374151] dark:text-[#d1d5db]">
                  {t}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 3: TECHNICAL ARSENAL & SKILLS -->
    <section id="stack" class="mb-16 sm:mb-24 scroll-mt-20">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-[#e4e7eb] dark:border-[#222630]">
        <div>
          <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400">03 / ARSENAL TEKNIS</span>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#0f141c] dark:text-[#f4f5f7] mt-0.5">
            Keahlian & Penguasaan Tools
          </h2>
        </div>
        <span class="text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
          5 Domain Utama
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {skills.map((cat) => (
          <div class="p-5 rounded-2xl border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] hover:border-[#cbd2d9] dark:hover:border-[#323846] transition-colors space-y-3">
            <div>
              <h3 class="text-sm font-bold text-[#0f141c] dark:text-[#f4f5f7]">
                {cat.category}
              </h3>
              <p class="text-xs text-[#6b7280] dark:text-[#9ca3af] mt-0.5">
                {cat.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-1">
              {cat.items.map((item) => (
                <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-[#f8f9fa] dark:bg-[#090a0c] border border-[#e4e7eb] dark:border-[#222630] text-[#374151] dark:text-[#d1d5db] hover:border-emerald-500/50 transition-colors">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 4: EDUCATION & CREDENTIALS -->
    <section id="kredensial" class="mb-16 sm:mb-24 scroll-mt-20">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-[#e4e7eb] dark:border-[#222630]">
        <div>
          <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400">04 / KREDENSIAL</span>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#0f141c] dark:text-[#f4f5f7] mt-0.5">
            Pendidikan & Lisensi
          </h2>
        </div>
        <span class="text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
          Latar Belakang
        </span>
      </div>

      <div class="space-y-6">
        <!-- Education Card -->
        <div class="p-5 sm:p-6 rounded-2xl border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317]">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-base font-bold text-[#0f141c] dark:text-[#f4f5f7]">
              {education[0].institution}
            </h3>
            <span class="text-xs font-mono text-[#6b7280] dark:text-[#9ca3af]">
              {education[0].period}
            </span>
          </div>
          <p class="text-xs sm:text-sm font-medium text-[#374151] dark:text-[#d1d5db] mt-1">
            {education[0].degree}
          </p>
          <div class="mt-3 flex items-center gap-2 text-xs font-mono">
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20 font-bold">
              IPK: {education[0].gpa}
            </span>
            <span class="text-[#6b7280] dark:text-[#9ca3af]">{education[0].notes}</span>
          </div>
        </div>

        <!-- Certifications & Languages Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Certifications -->
          <div class="p-5 rounded-2xl border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] space-y-3">
            <h4 class="text-xs font-mono uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">
              Sertifikasi Profesional
            </h4>
            <ul class="space-y-3 text-xs text-[#374151] dark:text-[#d1d5db]">
              {certifications.map((c) => (
                <li class="pb-2.5 border-b border-[#f1f3f5] dark:border-[#181b21] last:border-0 last:pb-0">
                  <div class="font-semibold text-[#0f141c] dark:text-[#f4f5f7]">{c.name}</div>
                  <div class="flex justify-between items-center text-[11px] font-mono text-[#6b7280] dark:text-[#9ca3af] mt-0.5">
                    <span>{c.issuer}</span>
                    <span>{c.year}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Languages -->
          <div class="p-5 rounded-2xl border border-[#e4e7eb] dark:border-[#222630] bg-white dark:bg-[#111317] space-y-3">
            <h4 class="text-xs font-mono uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">
              Kemahiran Bahasa
            </h4>
            <ul class="space-y-3 text-xs text-[#374151] dark:text-[#d1d5db]">
              {languages.map((l) => (
                <li class="p-3 rounded-xl bg-[#f8f9fa] dark:bg-[#090a0c] border border-[#e4e7eb] dark:border-[#222630]">
                  <div class="font-bold text-[#0f141c] dark:text-[#f4f5f7]">{l.language}</div>
                  <div class="text-[11px] font-mono text-[#4b5563] dark:text-[#9ca3af] mt-0.5">{l.proficiency}</div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CRAFTSMANSHIP FOOTER -->
    <footer class="pt-10 pb-6 border-t border-[#e4e7eb] dark:border-[#222630] text-xs font-mono text-[#6b7280] dark:text-[#9ca3af] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>{profile.name} : Surabaya, Jawa Timur, Indonesia</span>
      </div>

      <div class="flex items-center gap-4">
        <a href={`mailto:${profile.email}`} class="hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-colors">
          Kirim Email
        </a>
        <span>•</span>
        <a href="#proyek" class="hover:text-[#0f141c] dark:hover:text-[#f4f5f7] transition-colors">
          Kembali ke Atas ↑
        </a>
      </div>
    </footer>

    <!-- Interactive Copy Toast Feedback Notification (R-26 / C-2) -->
    <div
      id="copy-toast"
      class="fixed bottom-6 right-6 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-200 bg-[#0f141c] text-[#f8f9fa] dark:bg-[#f4f5f7] dark:text-[#090a0c] px-4 py-2.5 rounded-xl shadow-lg text-xs font-mono flex items-center gap-2"
      role="status"
    >
      <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span>Email disalin ke clipboard</span>
    </div>

  </main>

  <!-- Client-side Interactive Controller (Tabs, Theme, Copy) -->
  <script is:inline>
    (function () {
      // 1. Theme Switcher with Persistence
      const themeToggle = document.getElementById('btn-theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // 2. Email Copy with Visual Toast Feedback
      const copyBtn = document.getElementById('btn-copy-nav');
      const copyToast = document.getElementById('copy-toast');
      if (copyBtn && copyToast) {
        copyBtn.addEventListener('click', async () => {
          const email = copyBtn.getAttribute('data-email');
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
            copyToast.classList.remove('opacity-0', 'translate-y-2');
            copyToast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
              copyToast.classList.remove('opacity-100', 'translate-y-0');
              copyToast.classList.add('opacity-0', 'translate-y-2');
            }, 2200);
          } catch (e) {
            console.error('Copy failed', e);
          }
        });
      }

      // 3. Project Interactive Tabs Controller (Architecture / Highlights / Stack)
      const projectGroups = document.querySelectorAll('.project-tab-group');
      projectGroups.forEach((group) => {
        const buttons = group.querySelectorAll('.tab-btn');
        const architecturePanel = group.querySelector('.tab-panel-architecture');
        const highlightsPanel = group.querySelector('.tab-panel-highlights');
        const stackPanel = group.querySelector('.tab-panel-stack');

        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-tab');

            // Reset active styles on all buttons in this group
            buttons.forEach((b) => {
              b.classList.remove('active', 'bg-white', 'dark:bg-[#111317]', 'shadow-sm', 'text-[#0f141c]', 'dark:text-[#f4f5f7]', 'font-semibold');
              b.classList.add('text-[#6b7280]', 'dark:text-[#9ca3af]');
            });

            // Set active styles on clicked button
            btn.classList.add('active', 'bg-white', 'dark:bg-[#111317]', 'shadow-sm', 'text-[#0f141c]', 'dark:text-[#f4f5f7]', 'font-semibold');
            btn.classList.remove('text-[#6b7280]', 'dark:text-[#9ca3af]');

            // Toggle panels
            if (architecturePanel) architecturePanel.classList.toggle('hidden', targetTab !== 'architecture');
            if (highlightsPanel) highlightsPanel.classList.toggle('hidden', targetTab !== 'highlights');
            if (stackPanel) stackPanel.classList.toggle('hidden', targetTab !== 'stack');
          });
        });
      });
    })();
  </script>
</Layout>
